RewriteEngine On

# Prevent Directory Browsing
Options -Indexes

# Protect sensitive environment and configuration files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Login & Admin Clean URLs
RewriteRule ^login/?$ admin/login.php [L,QSA]

# Investment Opportunities Details Clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^investment-opportunities/([a-z0-9\-]+)/?$ investment-opportunities/detail.php?slug=$1 [L,QSA]

# Blog Article Details Clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-z0-9\-]+)/?$ blog/post.php?slug=$1 [L,QSA]
