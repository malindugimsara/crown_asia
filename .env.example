# =====================================================================
# Crown Asia LLC - Environment Configuration Template (.env.example)
# =====================================================================
# Copy this file to .env and configure your secret credentials.

APP_NAME="Crown Asia LLC"
APP_ENV=development
APP_URL=http://localhost:8888/crown_asia/

# =====================================================================
# Database Configuration
# =====================================================================
DB_HOST=localhost
DB_NAME=crown_asia
DB_USER=root
DB_PASS=

# =====================================================================
# SMTP Mail Server Configuration
# =====================================================================
# Gmail:        SMTP_HOST=smtp.gmail.com | SMTP_PORT=587 | SMTP_SECURE=tls (Use Google App Password)
# cPanel/Web:   SMTP_HOST=mail.yourdomain.com | SMTP_PORT=465 | SMTP_SECURE=ssl
# Brevo/Relay:  SMTP_HOST=smtp-relay.brevo.com | SMTP_PORT=587 | SMTP_SECURE=tls
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# =====================================================================
# Sender Identity (Appears in outgoing emails)
# =====================================================================
MAIL_FROM_ADDRESS=web@crownasia.io
MAIL_FROM_NAME="Crown Asia LLC"
MAIL_REPLY_TO=web@crownasia.io

# =====================================================================
# Admin Notification Recipient (Receives user inquiries)
# =====================================================================
ADMIN_EMAIL=admin@crownasia.io
ADMIN_NAME="Crown Asia Inquiries Desk"
